+// normalizeLegacyMapArea fills fields which were added to mower_map/MapArea
+// after this GUI was originally generated. The legacy editor does not expose
+// these settings, so preserve the current OpenMower defaults.
+func normalizeLegacyMapArea(area *mower_map.MapArea) {
+	area.Active = true
+	area.Angle = math.NaN()
+	area.OutlineCount = -1
